[
  { "id": "hola-hola", "world": 1, "title": "¡Hola, hola!", "en": "Hello, hello!", "emoji": "👋", "bpm": 92, "lines": [
    {"who": "sol", "es": "¡Hola, hola! ¿Qué tal?", "en": "Hello, hello! How are you?"},
    {"who": "luna", "es": "¡Muy bien, muy bien, genial!", "en": "Very well, very well, great!"},
    {"who": "sol", "es": "¡Buenos días, sol brillante!", "en": "Good morning, bright sun!"},
    {"who": "luna", "es": "¡Buenas tardes, elefante!", "en": "Good afternoon, elephant!"},
    {"who": "sol", "es": "¡Buenas noches, luna bella!", "en": "Good night, lovely moon!"},
    {"who": "luna", "es": "¡Adiós, adiós, estrella!", "en": "Goodbye, goodbye, star!"}
  ] },
  { "id": "hasta-diez", "world": 1, "title": "Cuento hasta diez", "en": "I count to ten", "emoji": "🔟", "bpm": 96, "lines": [
    {"who": "sol", "es": "Uno, dos, tres, ¡salta otra vez!", "en": "One, two, three, jump again!"},
    {"who": "luna", "es": "Cuatro, cinco, seis, ¡mueve los pies!", "en": "Four, five, six, move your feet!"},
    {"who": "sol", "es": "Siete, ocho, nueve, ¡nadie se mueve!", "en": "Seven, eight, nine, nobody moves!"},
    {"who": "luna", "es": "¡Y diez! ¡Otra vez!", "en": "And ten! Once again!"}
  ] },
  { "id": "colores", "world": 1, "title": "¿De qué color es?", "en": "What colour is it?", "emoji": "🎨", "bpm": 90, "lines": [
    {"who": "sol", "es": "¿De qué color es la fresa?", "en": "What colour is the strawberry?"},
    {"who": "luna", "es": "¡Roja, roja, la fresa!", "en": "Red, red, the strawberry!"},
    {"who": "sol", "es": "¿De qué color es el mar?", "en": "What colour is the sea?"},
    {"who": "luna", "es": "¡Azul, azul, el mar!", "en": "Blue, blue, the sea!"},
    {"who": "sol", "es": "¿De qué color es el sol?", "en": "What colour is the sun?"},
    {"who": "luna", "es": "¡Amarillo, amarillo, el sol!", "en": "Yellow, yellow, the sun!"}
  ] },
  { "id": "cabeza-hombros", "world": 1, "title": "Cabeza, hombros, rodillas y pies", "en": "Head, shoulders, knees and toes", "emoji": "🙆", "bpm": 100, "lines": [
    {"who": "sol", "es": "Cabeza, hombros, rodillas y pies.", "en": "Head, shoulders, knees and feet."},
    {"who": "luna", "es": "¡Rodillas y pies!", "en": "Knees and feet!"},
    {"who": "sol", "es": "Ojos, orejas, boca y nariz.", "en": "Eyes, ears, mouth and nose."},
    {"who": "luna", "es": "¡Cabeza, hombros, rodillas y pies!", "en": "Head, shoulders, knees and feet!"}
  ] },
  { "id": "la-semana", "world": 2, "title": "Los días de la semana", "en": "The days of the week", "emoji": "📅", "bpm": 92, "lines": [
    {"who": "sol", "es": "Lunes, martes, miércoles, tres.", "en": "Monday, Tuesday, Wednesday, three."},
    {"who": "luna", "es": "Jueves, viernes, sábado, seis.", "en": "Thursday, Friday, Saturday, six."},
    {"who": "sol", "es": "Y domingo, siete son.", "en": "And Sunday, that makes seven."},
    {"who": "luna", "es": "¡Siete días, qué ilusión!", "en": "Seven days, how exciting!"}
  ] },
  { "id": "que-tiempo", "world": 2, "title": "¿Qué tiempo hace?", "en": "What's the weather like?", "emoji": "🌦️", "bpm": 90, "lines": [
    {"who": "sol", "es": "¿Qué tiempo hace hoy?", "en": "What's the weather like today?"},
    {"who": "luna", "es": "¡Hace sol, hace sol!", "en": "It's sunny, it's sunny!"},
    {"who": "sol", "es": "¿Y mañana, qué será?", "en": "And tomorrow, what will it be?"},
    {"who": "luna", "es": "¡Llueve, llueve, ya verás!", "en": "Rain, rain, you'll see!"},
    {"who": "sol", "es": "Si hace frío, me pongo el abrigo.", "en": "If it's cold, I put on my coat."},
    {"who": "luna", "es": "Si hace calor, ¡a la playa contigo!", "en": "If it's hot, to the beach with you!"}
  ] },
  { "id": "buenas-noches", "world": 3, "title": "Buenas noches", "en": "Good night", "emoji": "🌙", "bpm": 76, "lines": [
    {"who": "luna", "es": "La luna sale, el sol se va.", "en": "The moon comes out, the sun goes away."},
    {"who": "sol", "es": "Es hora de dormir ya.", "en": "It's time to go to sleep now."},
    {"who": "luna", "es": "Me lavo los dientes, me pongo el pijama.", "en": "I brush my teeth, I put on my pyjamas."},
    {"who": "sol", "es": "Y un beso de mamá en la cama.", "en": "And a kiss from Mum in bed."},
    {"who": "luna", "es": "¡Buenas noches, hasta mañana!", "en": "Good night, see you tomorrow!"}
  ] },
  { "id": "estaciones", "world": 10, "title": "Las cuatro estaciones", "en": "The four seasons", "emoji": "🍂", "bpm": 88, "lines": [
    {"who": "sol", "es": "En primavera, flores.", "en": "In spring, flowers."},
    {"who": "luna", "es": "En verano, calor.", "en": "In summer, heat."},
    {"who": "sol", "es": "En otoño, hojas de colores.", "en": "In autumn, colourful leaves."},
    {"who": "luna", "es": "En invierno, ¡qué frío, por favor!", "en": "In winter, it's so cold!"}
  ] },
  { "id": "hoy-he", "world": 13, "title": "¿Qué has hecho hoy?", "en": "What have you done today?", "emoji": "🌅", "bpm": 94, "lines": [
    {"who": "sol", "es": "¿Qué has hecho hoy? ¿Qué has hecho hoy?", "en": "What have you done today? What have you done today?"},
    {"who": "luna", "es": "He leído un libro y he jugado al fútbol.", "en": "I've read a book and I've played football."},
    {"who": "sol", "es": "¿Y qué más has hecho? ¿Y qué más has hecho?", "en": "And what else have you done? And what else have you done?"},
    {"who": "luna", "es": "He comido paella y he visto el mar.", "en": "I've eaten paella and I've seen the sea."},
    {"who": "sol", "es": "¿Y los deberes? ¿Los has terminado?", "en": "And your homework? Have you finished it?"},
    {"who": "luna", "es": "¡Todavía no! ¡Ay, se me ha olvidado!", "en": "Not yet! Oh, I've forgotten!"}
  ] },
  { "id": "ayer-ayer", "world": 14, "title": "Ayer, ayer", "en": "Yesterday, yesterday", "emoji": "🏖️", "bpm": 96, "lines": [
    {"who": "sol", "es": "Ayer, ayer, ¿qué hiciste ayer?", "en": "Yesterday, yesterday, what did you do yesterday?"},
    {"who": "luna", "es": "Monté en bici y comí puré.", "en": "I rode my bike and I ate mash."},
    {"who": "sol", "es": "Anoche, anoche, ¿qué hiciste anoche?", "en": "Last night, last night, what did you do last night?"},
    {"who": "luna", "es": "Bailé y canté y salí en coche.", "en": "I danced and I sang and I went out in the car."},
    {"who": "sol", "es": "¿Y el domingo? ¿Qué pasó?", "en": "And on Sunday? What happened?"},
    {"who": "luna", "es": "¡Me bañé en el mar y el sol brilló!", "en": "I swam in the sea and the sun shone!"}
  ] },
  { "id": "fui-fuiste", "world": 15, "title": "Fui, fuiste, fue", "en": "I went, you went, he went", "emoji": "⛰️", "bpm": 98, "lines": [
    {"who": "sol", "es": "Fui, fuiste, fue: ¡a la montaña fue!", "en": "I went, you went, he went: to the mountains he went!"},
    {"who": "luna", "es": "Fuimos, fuisteis, fueron: ¡todos se fueron!", "en": "We went, you all went, they went: they all went away!"},
    {"who": "sol", "es": "Hice, hiciste, hizo: ¡qué frío hizo!", "en": "I did, you did, he did: how cold it was!"},
    {"who": "luna", "es": "Tuve, tuviste, tuvo: ¡un susto tuvo!", "en": "I had, you had, he had: he had a fright!"},
    {"who": "sol", "es": "Dije, traje, puse: ¡todo lo hice!", "en": "I said, I brought, I put: I did it all!"},
    {"who": "luna", "es": "¡Y colorín colorado, este cuento se ha acabado!", "en": "And that's the end of the story!"}
  ] },
  { "id": "cuando-era", "world": 16, "title": "Cuando era pequeño", "en": "When I was little", "emoji": "🧸", "bpm": 90, "lines": [
    {"who": "sol", "es": "Cuando era pequeño, ¿sabes qué hacía?", "en": "When I was little, do you know what I did?"},
    {"who": "luna", "es": "¡Jugaba en el parque y la sandía comía!", "en": "I played in the park and I ate watermelon!"},
    {"who": "sol", "es": "Cuando era pequeña, ¿qué te gustaba?", "en": "When you were little, what did you like?"},
    {"who": "luna", "es": "¡Saltar a la comba y la tele no miraba!", "en": "Skipping, and I didn't watch TV!"},
    {"who": "sol", "es": "Antes era pequeño, ahora soy mayor.", "en": "Before I was little, now I'm big."},
    {"who": "luna", "es": "¡Y todavía me gusta jugar con el sol!", "en": "And I still like playing in the sun!"}
  ] }
]
