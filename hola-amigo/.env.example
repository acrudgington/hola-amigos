# Copy to .env.local (never commit it) and fill in, or set these in your
# hosting provider's environment variables. See FIREBASE_SETUP.md.
#
# "local"    = everything stays on the device (default, no setup needed)
# "firebase" = parent accounts + cloud sync across devices
VITE_BACKEND=local

# From Firebase console → Project settings → Your apps → Web app → SDK config.
# These identify your project; they are not secrets (access is controlled by
# firestore.rules), but keep them out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Development only: talk to the local emulators (npm run emulators) instead.
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
